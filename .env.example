
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_MODE=chat_completions

LLM_FAST_MODEL=
LLM_REASONING_EFFORT=

EXA_API_KEY=

PORT=3000
DB_PATH=data/asof.db

# Compatible-host capabilities; default max_completion_tokens and streaming usage.
LLM_TOKEN_LIMIT_PARAMETER=max_completion_tokens
LLM_STREAM_USAGE=1

# Local deployment binds loopback. Hosted mode requires HTTPS origins, owner tokens and prices.
DEPLOYMENT_MODE=local
ALLOWED_ORIGINS=
# JSON object: {"owner_id":"unique_random_token_at_least_32_characters"}
OWNER_TOKENS=
MAX_ACTIVE_TURNS=4
MAX_QUEUED_TURNS=16
MAX_ACTIVE_MODELS=4
MAX_QUEUED_MODELS=24
MODEL_REQUESTS_PER_MINUTE=120
MODEL_TOKENS_PER_MINUTE=1000000
# Account headroom for final synthesis/review, unavailable to research/enrichment.
# Defaults adapt to admitted-turn/token limits when unset.
MODEL_COMPLETION_REQUEST_RESERVE=
MODEL_COMPLETION_TOKEN_RESERVE=
TURN_TIMEOUT_MS=120000
MAX_TURN_MODEL_CALLS=10
MAX_TURN_TOKENS=100000
MAX_OUTPUT_TOKENS=4096
MAX_TURN_DOLLARS=1
# Conservative upper bound for ONE Exa HTTP attempt, including requested content.
# Every real search path requires this bound before provider HTTP, including local mode.
SEARCH_MAX_ATTEMPT_DOLLARS=
# Configure conservative, documented budgeting rates for the shared turn/account allowance.
# These estimates are distinct from invoice rates; every paid deployment also needs the map below.
INPUT_DOLLARS_PER_MILLION=
OUTPUT_DOLLARS_PER_MILLION=
MODEL_PRICE_VERSION=operator-v1
SHUTDOWN_MS=10000
TRACE_RETENTION_DAYS=14
# Opt in to automatic task-specific profile selection after paired quality validation.
# Required verification/historical policies and explicit bounded source reads remain available.
RETRIEVAL_PROFILES=0

# One durable remaining allowance for the entire product-completion campaign, across all CLIs/restarts.
# The ledger is fixed at this repository's data/provider-spend.db. Never delete it to reset spending.
AZURE_TOTAL_BUDGET_DOLLARS=30
EXA_TOTAL_BUDGET_DOLLARS=20
# JSON map of documented conservative envelopes for every allowed deployment; unknown models fail closed.
# Example schema only: {"deployment":{"inputPerMillionUsd":1,"outputPerMillionUsd":2,"cachedInputPerMillionUsd":1}}
MODEL_DEPLOYMENT_PRICES_JSON=
