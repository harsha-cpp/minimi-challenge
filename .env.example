# Copy to .env and fill in. Two keys are required: one model, one search.

# --- Model: any OpenAI-compatible Chat Completions endpoint ------------------
LLM_API_KEY=
# The model (or, on Azure Foundry, the deployment name).
LLM_MODEL=
# Leave empty for api.openai.com. Examples for other hosts:
#   Azure Foundry:  https://YOUR-RESOURCE.openai.azure.com/openai/v1/
#   Fireworks:      https://api.fireworks.ai/inference/v1
LLM_BASE_URL=

# Optional: a cheaper model for the background memory step (defaults to LLM_MODEL).
LLM_FAST_MODEL=
# Optional: passed through as `reasoning_effort` for models that accept it.
LLM_REASONING_EFFORT=

# --- Web search: Exa (https://dashboard.exa.ai/api-keys) ----------------------
EXA_API_KEY=

# --- Optional ----------------------------------------------------------------
PORT=3000
# Where the conversation log lives.
DB_PATH=data/asof.db
# Start the agent's clock at another moment (ISO 8601) to test date questions.
# AGENT_NOW=2026-11-03T10:00:00+05:30
