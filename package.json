{
  "name": "asof",
  "version": "0.1.0",
  "private": true,
  "description": "A chat agent with one tool (web search) that remembers what it claimed and when.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx --disable-warning=ExperimentalWarning src/server.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test --test-reporter=spec test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "eval": "tsx --disable-warning=ExperimentalWarning eval/replay.ts",
    "eval:search": "tsx --disable-warning=ExperimentalWarning eval/search.ts",
    "eval:benchmark": "tsx --disable-warning=ExperimentalWarning eval/benchmark.ts",
    "eval:models": "tsx --disable-warning=ExperimentalWarning eval/compare-models.ts",
    "eval:simulation": "tsx --disable-warning=ExperimentalWarning eval/simulation.ts",
    "import": "tsx --disable-warning=ExperimentalWarning scripts/import.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "dompurify": "^3.4.17",
    "jsdom": "^27.4.0",
    "marked": "^18.2.0",
    "openai": "^7.55.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
